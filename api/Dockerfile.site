# Site do gba (docs/) servido por nginx. Contexto do build: a raiz do repositório.
FROM nginx:1.29-alpine
ARG VERSAO=dev
# upgrade: correções de segurança do Alpine sem esperar a imagem base.
RUN apk upgrade --no-cache
COPY api/nginx.conf /etc/nginx/conf.d/default.conf
COPY docs/ /usr/share/nginx/html/
# O CI espera ver a versão nova em /versao.json para dar o deploy por concluído.
RUN printf '{"versao":"%s"}\n' "$VERSAO" > /usr/share/nginx/html/versao.json
